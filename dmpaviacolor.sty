\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{dmpaviacolor}[2026/10/06 DM UniPV colour palette]

\RequirePackage{xcolor}

% Main colour
\definecolor{unipvred}{RGB}{175, 45, 82}
\colorlet{maincolor}{unipvred}
\colorlet{darkred}{unipvred}
\definecolor{unipvblue}{RGB}{30,72,159}

% Neutrals and maroon tints used by the theme
\definecolor{dmink}{HTML}{262626}      % headings
\definecolor{dmtext}{HTML}{333333}     % body text
\definecolor{dmsubtext}{HTML}{595959}  % second-level text, subtitles
\definecolor{dmmuted}{HTML}{7F7F7F}    % footer, captions
\definecolor{dmlightmuted}{HTML}{A6A6A6}
\definecolor{dmtint}{HTML}{F6E9ED}     % result / theorem cards
\definecolor{dmblush}{HTML}{F2D9E0}    % light text on maroon
\definecolor{dmpink}{HTML}{E6AFBF}     % section numbers (diagonal style)
\definecolor{dmnumred}{HTML}{C65A7A}   % giant numerals (numeral style)

% "Warm grey"
\definecolor{sintefgrey}{RGB/cmyk}{235,235,230/0,0,0,.1}
